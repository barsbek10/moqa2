---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import Foodapps from "@/partials/Foodapps.astro";
import Button from "@/shortcodes/Button.tsx";

const menu = (await getEntry("menu", "-index")) as CollectionEntry<"menu">;
const { title, description, default_food_image, foods, drinks = [] } = menu.data;

const groups = [
  ...new Set(foods.map((food) => food.group.toLocaleLowerCase())),
];

const drinkGroups = [
  ...new Set(drinks.map((drink) => drink.group.toLocaleLowerCase())),
];
---

<Base {...menu.data}>
  <section class="section pt-16 xl:pt-20 second_background_color">
    <div class="container">
      <div class="row justify-center">
        <div class="md:col-8 sm:col-10 lg:col-6 text-center capitalize">
          <h1
            class="mb-6 xl:text-[100px] font-normal"
            set:html={markdownify(title)}
          />
          <p class="text-balance" set:html={markdownify(description)} />
        </div>
        <div class="text-center pt-3">
          <p class="text-balance font-bold pb-2">
            Check out our most up-to-date and full menu in pdf
          </p>
          <Button
            link="menuV3.pdf"
            label="Menu.pdf"
            className="w-fit bg-primary hover:border-primary! text-white transition-colors! duration-10 hover:text-text-gallery-back"
          />
        </div>
      </div>



      <!-- shuffle menus section -->
      <div class="mt-6">
        <ul
          class="shuffle-filter flex flex-wrap gap-4 justify-center items-center bg-body p-2 lg:py-1 mb-14 rounded-full second_background_color"
        >
          <li class="btn bg-secondary text-white py-2" data-target="all">
            All
          </li>

          <!-- Drinks button -->
          {
            drinks.length > 0 && (
              <li
                data-target="drinks"
                class="btn py-2 hover:bg-secondary hover:text-white transition-all duration-300"
              >
                Drinks
              </li>
            )
          }

          {
            groups.map((group) => (
              <li
                data-target={group}
                class="btn py-2 hover:bg-secondary hover:text-white transition-all duration-300"
              >
                {group}
              </li>
            ))
          }
        </ul>

        <!-- drinks block (hidden by default, shown only when Drinks is active) -->
        {
          drinks.length > 0 && (
            <div id="drinks-block" class="mt-10 hidden">
              <div
                class="border border-border rounded-[1.125rem] bg-body p-6 md:p-10 max-w-4xl mx-auto"
              >
                <h2 class="text-center mb-8 font-primary text-2xl md:text-3xl">
                  Drinks
                </h2>

                <div class="grid gap-6 md:grid-cols-2">
                  {
                    drinkGroups.map((groupKey) => {
                      const groupItems = drinks.filter(
                        (drink) =>
                          drink.group.toLocaleLowerCase() === groupKey
                      );

                      const groupLabel = groupItems[0]?.group ?? groupKey;

                      return (
                        <div>
                          <h3 class="uppercase tracking-[0.2em] text-sm text-secondary font-bold mb-4">
                            {groupLabel}
                          </h3>
                          <ul class="space-y-3">
                            {
                              groupItems.map((drink) => (
                                <li class="border-b border-border/60 pb-2">
                                  <div class="flex justify-between items-baseline gap-4 flex-wrap">
                                    <span class="font-medium">
                                      {drink.name}
                                    </span>
                                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm justify-end">
                                      {
                                        drink.sizes?.map((size) => (
                                          <span class="flex items-baseline gap-1">
                                          {
                                            size.label && (
                                              <span class="uppercase tracking-wide font-bold">
                                                {size.label}
                                              </span>
                                            )
                                          }
                                          <span class="font-semibold text-secondary">
                                            {size.currency}{size.price}
                                          </span>
                                        </span>
                                        ))
                                      }
                                    </div>
                                  </div>

                                  {drink.description && (
                                    <p class="mt-1 text-xs opacity-80">
                                      {drink.description}
                                    </p>
                                  )}
                                </li>
                              ))
                            }
                          </ul>
                        </div>
                      );
                    })
                  }
                </div>
              </div>
            </div>
          )
        }

        <ul
          id="foods-grid"
          class="row justify-center gy-5 gx-4 shuffle-container mx-auto w-full items-stretch"
        >
          {
            foods.map((item, i) => (
              <li
                data-groups={`["${item.group.toLocaleLowerCase()}","all"]`}
                class="col-12 sm:col-6 lg:col-3 mx-auto flex"
              >
                <div class="border border-border rounded-xl overflow-hidden max-w-xs mx-auto w-full flex flex-col h-full">
                  <ImageMod
                    src={item?.image ?? default_food_image}
                    alt={`member-${item.name}`}
                    class="h-[230px] w-full object-cover"
                    width={400}
                    height={300}
                    loading="lazy"
                  />
                  <div class="p-7 text-center flex flex-col flex-1">
                    <h4 class="text-secondary font-primary h6 font-bold">
                      <span>{markdownify(item.currency)}</span>
                      {markdownify(item.price)}
                    </h4>
                    <h3
                      class="font-semibold text-lg font-primary my-4"
                      set:html={markdownify(item.name)}
                    />
                    { item.description && (
                      <p
                        class="text-sm"
                        set:html={markdownify(item.description)}
                      />
                    )}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Foodapps/>
</Base>
<script>
  document.addEventListener("astro:page-load", () => {
    const container = document.querySelector(".shuffle-container"); // foods grid
    if (!container) return;

    const items = container.querySelectorAll("li");
    const filterButtons = document.querySelectorAll(".shuffle-filter li");
    const drinksBlock = document.querySelector("#drinks-block");
    const foodsGrid = document.querySelector("#foods-grid");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", function (e) {
        e.preventDefault();

        // Reset active states
        filterButtons.forEach((b) => {
          b.classList.remove("bg-secondary", "text-white");
          b.classList.add("hover:bg-secondary", "hover:text-white");
        });

        // Set active state on selected button
        this.classList.add("bg-secondary", "text-white");
        this.classList.remove("hover:bg-secondary", "hover:text-white");

        const keyword = this.getAttribute("data-target");

        // Special case: Drinks
        if (keyword === "drinks") {
          if (foodsGrid) foodsGrid.classList.add("hidden");
          if (drinksBlock) drinksBlock.classList.remove("hidden");
          return;
        } else {
          if (foodsGrid) foodsGrid.classList.remove("hidden");
          if (drinksBlock) drinksBlock && drinksBlock.classList.add("hidden");
        }

        // Normal filtering for foods
        items.forEach((item) => {
          const groups = JSON.parse(item.getAttribute("data-groups") || "[]");

          if (keyword === "all" || groups.includes(keyword)) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });

    // Make sure drinks block is hidden initially
    if (drinksBlock) {
      drinksBlock.classList.add("hidden");
    }
  });
</script>
