---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import Foodapps from "@/partials/Foodapps.astro";

const menu = (await getEntry("menu", "-index")) as CollectionEntry<"menu">;
const { title, description, default_food_image, foods } = menu.data;

const groups = [
  ...new Set(foods.map((food) => food.group.toLocaleLowerCase())),
];
---

<Base {...menu.data}>
  <section class="section pt-16 xl:pt-20 second_background_color">
    <div class="container">
      <div class="row justify-center">
        <div class="md:col-8 sm:col-10 lg:col-6 text-center capitalize">
          <h1
            class="mb-6 xl:text-[100px] font-normal"
            set:html={markdownify(title)}
          />
          <p class="text-balance" set:html={markdownify(description)} />
        </div>
      </div>

      <!-- shuffle menus section  -->
      <div class="mt-6">
        <ul
          class="shuffle-filter flex flex-wrap gap-4 justify-center items-center bg-body p-2 lg:py-1 mb-14 rounded-full second_background_color"
        >
          <li class="btn bg-secondary text-white py-2" data-target="all">
            All
          </li>
          {
            groups.map((group) => (
              <li
                data-target={group}
                class="btn py-2 hover:bg-secondary hover:text-white transition-all duration-300"
              >
                {group}
              </li>
            ))
          }
        </ul>

        <ul
          class="row justify-center gy-5 gx-4 shuffle-container mx-auto w-full items-stretch"
        >
          {
            foods.map((item, i) => (
              <li
                data-groups={`["${item.group.toLocaleLowerCase()}","all"]`}
                class="col-12 sm:col-6 lg:col-3 mx-auto flex"
              >
                <div class="border border-border rounded-xl overflow-hidden max-w-xs mx-auto w-full flex flex-col h-full">
                  <ImageMod
                    src={item?.image ?? default_food_image}
                    alt={`member-${item.name}`}
                    class="h-[230px] w-full object-cover"
                    width={400}
                    height={300}
                    loading="lazy"
                  />
                  <div class="p-7 text-center flex flex-col flex-1">
                    <h4 class="text-secondary font-primary h6 font-bold">
                      <span>{markdownify(item.currency)}</span>
                      {markdownify(item.price)}
                    </h4>
                    <h3
                      class="font-semibold text-lg font-primary my-4"
                      set:html={markdownify(item.name)}
                    />
                    { item.description && (
                      <p
                        class="text-sm"
                        set:html={markdownify(item.description)}
                      />
                    )}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Foodapps/>

</Base>

<script>
  document.addEventListener("astro:page-load", () => {
    const container = document.querySelector(".shuffle-container");
    const items = container.querySelectorAll("li");
    const filterButtons = document.querySelectorAll(".shuffle-filter li");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", function (e) {
        e.preventDefault();

        // Reset active states
        filterButtons.forEach((b) => {
          b.classList.remove("bg-secondary", "text-white");
          b.classList.add("hover:bg-secondary", "hover:text-white");
        });

        // Set active state on selected button
        this.classList.add("bg-secondary", "text-white");
        this.classList.remove("hover:bg-secondary", "hover:text-white");

        const keyword = this.getAttribute("data-target");

        items.forEach((item) => {
          const groups = JSON.parse(item.getAttribute("data-groups") || "[]");

          if (keyword === "all" || groups.includes(keyword)) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  });
</script>
