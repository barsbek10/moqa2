---
import BlogCard from "@/components/BlogCard.astro";
import ImageMod from "@/components/ImageMod.astro";
import Share from "@/components/Share.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import similarItems from "@/lib/utils/similarItems";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const posts = await getSinglePage(BLOG_FOLDER);

  const paths = posts.map((post) => ({
    params: {
      single: post.id,
    },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;
const posts = await getSinglePage("blog");
const similarPosts = similarItems(post, posts);
const { Content } = await render(post);
const { title, description, meta_title, image } = post.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="section second_background_color pt-7">
    <div class="container">
      <div class="row justify-center">
        <article class="lg:col-10">
          <h1 set:html={markdownify(title)} class="h2 mt-8 mb-14 text-center" />
          {
            image && (
              <div class="mb-10">
                <ImageMod
                  src={image}
                  height={500}
                  width={1200}
                  alt={title}
                  class="w-full rounded"
                  format="webp"
                />
              </div>
            )
          }

          <div class="content mb-10">
            <Content />
          </div>
          <div class="row items-start justify-between">
            <div class="flex items-center lg:col-4">
              <h5 class="mr-3">Share :</h5>
              <Share
                className="social-icons-footer"
                title={title}
                description={description}
                slug={post.id}
              />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  {
    similarPosts.length > 0 && (
      <section class="section">
        <div class="container">
          <div>
            <h2 class="h3 mb-12 text-center">Read More Articles</h2>
            <div class="row justify-center g-4">
              {similarPosts.slice(0, 3).map((post) => (
                <div class="lg:col-3 md:col-6">
                  <BlogCard hideContent data={post} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</Base>
