---
import social from "@/config/social.json";
const { source, className } = Astro.props;
import DynamicIcon from "@/helpers/DynamicIcon";

export interface ISocial {
  name: string;
  icon: string;
  link: string;
  nickname: string;
}
---

<ul class={className}>
  {
    source.map((social: ISocial) => (
      <li>
        <a
          aria-label={social.name}
          href={social.link}
          target={social.link.startsWith("http") ? "_blank" : "_self"}
          rel="noopener noreferrer nofollow"
        >
          <span class="sr-only">{social.name}</span>
          <DynamicIcon className="inline-block" icon={social.icon} />
        </a>
        <!--<a-->
        <!--  aria-label={social.name}-->
        <!--  href={social.link}-->
        <!--  target={social.link.startsWith("http") ? "_blank" : "_self"}-->
        <!--  rel="noopener noreferrer nofollow"-->
        <!--  class="flex items-center"-->
        <!--&gt;-->
        <!--  <span class="sr-only">{social.name}</span>-->
        <!--  <DynamicIcon icon={social.icon} />-->
        <!--  <span class="mr-2 flex items-center">-->
        <!--    <DynamicIcon icon={social.icon} />-->
        <!--  </span>-->
        <!--  <span>{social.nickname}</span>-->
        <!--</a>-->
      </li>
    ))
  }
</ul>
